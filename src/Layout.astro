---
import Logo from './logo.svg';
import { EMAIL, INSTAGRAM } from './contact.js';

// overlay: white header on top of the home page hero, where the logo is the page's h1
const { title = 'Henk Bleeker Photography', image, overlay = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const Brand = overlay ? 'h1' : 'div';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Fine art photography by Henk Bleeker." />
    <link rel="icon" href={`${base}favicon.svg`} />
    <meta property="og:title" content={title} />
    {image && <meta property="og:image" content={image} />}
  </head>
  <body>
    <header class:list={{ overlay }}>
      <Brand class="logo"><a href={base}><Logo /></a></Brand>
      <nav>
        <a href={`${base}#work`} aria-label="Work">
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" /><path d="M9 3v18M15 3v18M3 9h18M3 15h18" /></svg>
        </a>
        <a href={`${base}about/`} aria-label="About">
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" /><path d="M7 8h10M7 12h10M7 16h6" /></svg>
        </a>
        <a href={INSTAGRAM} aria-label="Instagram">
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.3" cy="6.7" r=".5" /></svg>
        </a>
        <a href={`mailto:${EMAIL}`} aria-label="Email">
          <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" /><path d="m3 5 9 8 9-8" /></svg>
        </a>
      </nav>
    </header>
    <slot />
    <footer>© {new Date().getFullYear()} Henk Bleeker Photography</footer>
  </body>
</html>

<style is:global>
  :root {
    --gray: #7c7c73;
    --pad: clamp(16px, 3vw, 40px);
    font: 300 15px/1.5 'Helvetica Neue', Helvetica, Arial, sans-serif;
    color: #222;
    background: #fff;
  }
  body { margin: 0; }
  img { display: block; width: 100%; height: auto; }
  a { color: inherit; }
  svg { fill: none; stroke: currentColor; stroke-width: 1.2; }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px var(--pad);
    color: var(--gray);
  }
  header.overlay {
    position: absolute;
    inset: 0 0 auto;
    z-index: 1;
    color: #fff;
    filter: drop-shadow(0 0 4px rgb(0 0 0 / 0.6));
  }
  .logo { margin: 0; }
  .logo svg { display: block; width: 64px; height: auto; fill: currentColor; stroke: none; }
  nav { display: flex; gap: 12px; }
  nav svg { display: block; width: 20px; height: 20px; stroke-width: 1.5; }

  footer { padding: 32px var(--pad) 48px; text-align: center; font-size: 12px; letter-spacing: 0.1em; color: var(--gray); }
</style>
