---
import Logo from './logo.svg';
import { EMAIL, INSTAGRAM } from './contact.js';

// lang: 'nl' at the site root, 'en' under en/
// description: the snippet under the search result; photo: the image in link previews
// ld: this page's own schema.org nodes, next to the ones every page has
// overlay: header on top of the home page hero, where the logo is the page's h1
const { lang, title, description, photo, ld = [], overlay = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const home = lang === 'en' ? `${base}en/` : base;
const other = lang === 'en' ? 'nl' : 'en';
// this page in each language
const rest = Astro.url.pathname.slice(home.length);
const path = { nl: base + rest, en: `${base}en/${rest}` };
const abs = (p) => new URL(p, Astro.site).href;
const t = {
  nl: {
    job: 'kunst- en documentairefotograaf',
    description: 'Kunst- en documentairefotograaf Henk Bleeker uit Friesland: cowboys in de VS, boksers in Havana, de Mennonieten in Paraguay. Prints in de Wetlands Gallery.',
    work: 'Werk', news: 'Nieuws', about: 'Over Henk', email: 'E-mail', other: 'English', copy: 'kopieer', copied: 'gekopieerd',
  },
  en: {
    job: 'art and documentary photographer',
    description: 'Art and documentary photographer Henk Bleeker from Friesland: cowboys in the USA, boxers in Havana, the Mennonites of Paraguay. Prints at the Wetlands Gallery.',
    work: 'Work', news: 'News', about: 'About', email: 'Email', other: 'Nederlands', copy: 'copy', copied: 'copied',
  },
}[lang];
const pageTitle = title ?? `Henk Bleeker Photography · ${t.job}`;

// who Henk is, for search engines and language models; facts from the about page
const henk = { '@type': 'Person', '@id': abs(`${base}#henk`), name: 'Henk Bleeker' };
const place = { '@type': 'PostalAddress', addressLocality: 'Alde Leie', addressRegion: 'Friesland', addressCountry: 'NL' };
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      ...henk,
      jobTitle: t.job,
      birthDate: '1969',
      birthPlace: { '@type': 'Place', name: 'Hallum' },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Koninklijke Academie van Beeldende Kunsten' },
      address: place,
      email: EMAIL,
      image: abs(`${base}photos/henk-studio-1280.jpg`),
      url: abs(home),
      sameAs: [INSTAGRAM],
    },
    { '@type': 'WebSite', '@id': abs(`${base}#site`), url: abs(base), name: 'Henk Bleeker Photography', author: henk },
    {
      '@type': 'ArtGallery',
      name: 'Wetlands Gallery',
      url: abs(`${home}wetlands-gallery/`),
      address: { ...place, streetAddress: 'Leijester Hegedyk 27 b, Unit 10', postalCode: '9071 XB' },
      telephone: '+31651060719',
      founder: henk,
    },
    ...ld,
  ],
};
const Brand = overlay ? 'h1' : 'div';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? t.description} />
    <link rel="canonical" href={abs(path[lang])} />
    <link rel="alternate" hreflang="nl" href={abs(path.nl)} />
    <link rel="alternate" hreflang="en" href={abs(path.en)} />
    <link rel="alternate" hreflang="x-default" href={abs(path.nl)} />
    <link rel="icon" href={`${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Henk Bleeker Photography" />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'nl_NL'} />
    <meta property="og:url" content={abs(path[lang])} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description ?? t.description} />
    {photo && <meta property="og:image" content={abs(`${base}photos/${photo.file}-1280.jpg`)} />}
    {photo && <meta property="og:image:alt" content={photo.title} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <header class:list={{ overlay }}>
      <Brand class="logo"><a href={home}><Logo /></a></Brand>
      <nav>
        <a href={`${home}#work`} aria-label={t.work}>
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" /><path d="M9 3v18M15 3v18M3 9h18M3 15h18" /></svg>
        </a>
        <a href={`${home}news/`} aria-label={t.news}>
          <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" /><path d="M7 8h10M7 12h4M7 16h4M14 12h3v4h-3z" /></svg>
        </a>
        <a href={`${home}about/`} aria-label={t.about}>
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" /><path d="M7 8h10M7 12h10M7 16h6" /></svg>
        </a>
        <a href={`${home}wetlands-gallery/`} aria-label="Wetlands Gallery">
          <svg viewBox="0 0 24 24"><path d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11z" /><circle cx="12" cy="10" r="2.5" /></svg>
        </a>
        <a href={INSTAGRAM} aria-label="Instagram">
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.3" cy="6.7" r=".5" /></svg>
        </a>
        <a href={`mailto:${EMAIL}`} aria-label={t.email}>
          <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" /><path d="m3 5 9 8 9-8" /></svg>
        </a>
        <a class="lang" href={path[other]} hreflang={other} lang={other} aria-label={t.other}>{other.toUpperCase()}</a>
      </nav>
    </header>
    <slot />
    <footer>
      © {new Date().getFullYear()} Henk Bleeker Photography · <a href={`mailto:${EMAIL}`}>{EMAIL}</a> <button data-copy={EMAIL} data-done={t.copied}>{t.copy}</button>
    </footer>
    <script is:inline>
      // no "Save image" on right-click: only a hurdle, a screenshot still works
      addEventListener('contextmenu', (e) => e.target.closest('img') && e.preventDefault());
      // for visitors whose computer has no mail program, so the mailto link opens nothing
      addEventListener('click', (e) => {
        const b = e.target.closest('[data-copy]');
        if (!b) return;
        b.dataset.label ??= b.textContent;
        navigator.clipboard.writeText(b.dataset.copy).then(() => {
          b.textContent = b.dataset.done;
          setTimeout(() => (b.textContent = b.dataset.label), 2000);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --gray: #7c7c73;
    --pad: clamp(16px, 3vw, 40px);
    font: 300 15px/1.5 'Helvetica Neue', Helvetica, Arial, sans-serif;
    color: #222;
    background: #fff;
  }
  body { margin: 0; }
  img { display: block; width: 100%; height: auto; -webkit-user-drag: none; -webkit-touch-callout: none; user-select: none; }
  a { color: inherit; }
  svg { fill: none; stroke: currentColor; stroke-width: 1.2; }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px var(--pad);
    color: var(--gray);
  }
  header.overlay {
    position: absolute;
    inset: 0 0 auto;
    z-index: 1;
  }
  /* white logo on the hero's dark left. What sits behind the icons changes with the screen's shape
     (the photo is cropped to fill it), so they get a light backing of their own */
  header.overlay .logo { color: #fff; filter: drop-shadow(0 0 4px rgb(0 0 0 / 0.6)); }
  header.overlay nav {
    margin: -8px 0;
    padding: 8px 12px;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.75);
    backdrop-filter: blur(6px);
    color: #222;
  }
  .logo { margin: 0; }
  .logo svg { display: block; width: 64px; height: auto; fill: currentColor; stroke: none; }
  nav { display: flex; gap: 12px; }
  nav svg { display: block; width: 20px; height: 20px; stroke-width: 1.5; }
  .lang { margin-left: 4px; font-size: 12px; line-height: 20px; letter-spacing: 0.12em; text-decoration: none; }

  footer { padding: 32px var(--pad) 48px; text-align: center; font-size: 12px; letter-spacing: 0.1em; color: var(--gray); }
  [data-copy] { padding: 0; border: 0; background: none; font: inherit; letter-spacing: inherit; color: inherit; text-decoration: underline; cursor: pointer; }
  [data-copy]:hover { color: #222; }
</style>
