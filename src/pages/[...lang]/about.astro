---
import Layout from '../../Layout.astro';
import Photo from '../../Photo.astro';
import * as nl from '../../about/nl.md';
import * as en from '../../about/en.md';

export const getStaticPaths = () => [{ params: { lang: undefined } }, { params: { lang: 'en' } }];
const lang = Astro.params.lang ?? 'nl';
const bio = { nl, en }[lang];
const portraits = [
  { file: 'henk-portret', title: { nl: 'Henk Bleeker, zelfportret', en: 'Henk Bleeker, self-portrait' }[lang], width: 997, height: 1500 },
  { file: 'henk-studio', title: { nl: 'Henk Bleeker in zijn studio', en: 'Henk Bleeker in his studio' }[lang], width: 1500, height: 1500 },
];
---
<Layout lang={lang} title={`${bio.frontmatter.title} · Henk Bleeker Photography`}>
  <main class="about">
    <aside>
      {portraits.map((p) => <Photo photo={p} sizes="(min-width: 640px) 300px, 50vw" />)}
    </aside>
    <article>
      <h1>{bio.frontmatter.title}</h1>
      <bio.Content />
    </article>
  </main>
</Layout>

<style is:global>
  /* like Dean West: text column centred on the page, photos hanging to its left */
  .about {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) minmax(0, 580px) 1fr;
    gap: 32px;
    padding: 16px var(--pad) 48px;
  }
  .about aside { display: grid; gap: 16px; align-content: start; justify-self: end; width: min(100%, 300px); margin-top: 46px; }
  .about h1 { margin: 0 0 20px; font-size: 15px; font-weight: 400; letter-spacing: 2px; text-transform: uppercase; }
  .about p { margin: 0 0 1.4em; font-size: 14px; line-height: 1.75; }

  @media (max-width: 640px) {
    .about { grid-template-columns: 1fr; }
    .about aside { grid-template-columns: 1fr 1fr; align-items: start; width: 100%; margin-top: 0; }
  }
</style>
