---
import Layout from '../../Layout.astro';
import Photo from '../../Photo.astro';
import PhotoView from '../../PhotoView.astro';
import photos from '../../photos.json';
import Logo from '../../logo.svg';
import { workPath, imageObject } from '../../work.js';

// Dutch at the root, English under en/
export const getStaticPaths = () => [{ params: { lang: undefined } }, { params: { lang: 'en' } }];
const lang = Astro.params.lang ?? 'nl';
const t = {
  nl: { down: 'Scroll naar het werk', prev: 'Vorige', next: 'Volgende', close: 'Sluiten' },
  en: { down: 'Scroll to work', prev: 'Previous', next: 'Next', close: 'Close' },
}[lang];

const hero = photos.find((p) => p.file === '000010');

// credit on every photo, for image search
const gallery = { '@type': 'ImageGallery', image: photos.map((p) => imageObject(p, lang, Astro.site)) };
---
<Layout lang={lang} photo={hero} ld={[gallery]} overlay>
  <section class="hero">
    <Photo photo={hero} sizes={`max(100vw, ${Math.round((100 * hero.width) / hero.height)}vh)`} loading="eager" fetchpriority="high" />
    <a class="down" href="#work" aria-label={t.down}>
      <svg viewBox="0 0 24 24"><path d="m5 9 7 7 7-7" /></svg>
    </a>
  </section>

  {/* each photo links to its own page; with JS it opens in the lightbox instead */}
  <main id="work">
    {photos.map((p) => (
      <a class="thumb" href={workPath(p, lang)} data-open={`p-${p.file}`}>
        <Photo photo={p} sizes="(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw" />
      </a>
    ))}
  </main>

  {photos.map((p, i) => {
    const prev = photos.at(i - 1);
    const next = photos[(i + 1) % photos.length];
    return (
      <dialog id={`p-${p.file}`} data-url={workPath(p, lang)}>
        <header>
          <a class="logo" href={lang === 'en' ? `${import.meta.env.BASE_URL}en/` : import.meta.env.BASE_URL}><Logo /></a>
          <form method="dialog"><nav>
            <button type="button" data-open={`p-${prev.file}`} aria-label={t.prev} aria-keyshortcuts="ArrowLeft">
              <svg viewBox="0 0 24 24"><path d="m15 5-7 7 7 7" /></svg>
            </button>
            <button type="button" data-open={`p-${next.file}`} aria-label={t.next} aria-keyshortcuts="ArrowRight">
              <svg viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></svg>
            </button>
            <button aria-label={t.close} autofocus>
              <svg viewBox="0 0 24 24"><path d="M5 5l14 14M19 5 5 19" /></svg>
            </button>
          </nav></form>
        </header>
        <PhotoView photo={p} {lang} />
      </dialog>
    );
  })}

  <script is:inline>
    // the open photo's own address in the address bar: opening one adds a history entry, so Back closes it
    const home = location.pathname;
    for (const b of document.querySelectorAll('[data-open]'))
      b.addEventListener('click', (e) => {
        e.preventDefault();
        const d = document.getElementById(b.dataset.open);
        const was = document.querySelector('dialog[open]');
        was?.close();
        d.showModal();
        history[was ? 'replaceState' : 'pushState']({ photo: d.id }, '', d.dataset.url);
      });
    // Back and Forward between the gallery and a photo; the link to the story (#s-…) stays in the photo
    addEventListener('popstate', () => {
      const open = document.querySelector('dialog[open]');
      const id = location.pathname === home ? null : (history.state?.photo ?? open?.id);
      if (open?.id === id) return;
      open?.close();
      if (id) document.getElementById(id).showModal();
    });
    // ← → do what the < > buttons do
    addEventListener('keydown', (e) =>
      e.key.startsWith('Arrow') && document.querySelector(`dialog[open] [aria-keyshortcuts=${e.key}]`)?.click());
    for (const d of document.querySelectorAll('dialog')) {
      // click on the white space around the photo closes it
      d.addEventListener('click', (e) => e.target === d && d.close());
      // closed (not swapped for the next one): back to the gallery's address
      d.addEventListener('close', () => {
        if (document.querySelector('dialog[open]')) return;
        if (history.state?.photo) history.back();
        else history.replaceState(null, '', home);
      });
    }
  </script>
</Layout>

<style is:global>
  .hero { position: relative; height: 100svh; color: #fff; }
  .hero img { height: 100%; object-fit: cover; }
  .down { position: absolute; bottom: 20px; left: 50%; translate: -50%; filter: drop-shadow(0 0 4px rgb(0 0 0 / 0.6)); }
  .down svg { display: block; width: 32px; height: 32px; stroke-width: 1.5; }

  main { columns: 3 260px; column-gap: 24px; padding: var(--pad); }
  .thumb { display: block; margin: 0 0 24px; cursor: zoom-in; break-inside: avoid; }
  .thumb img { transition: opacity 0.3s; }
  .thumb:hover img { opacity: 0.85; }

  dialog {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #fff;
    box-sizing: border-box;
    padding-bottom: 5vh;
  }
  /* the site header's bar on top; photo centred below it, or scrolling from the top when a story follows */
  dialog[open] { display: flex; flex-direction: column; align-items: center; }
  body:has(dialog[open]) { overflow: hidden; }
  dialog header { position: sticky; top: 0; align-self: stretch; background: #fff; }
  dialog nav button { padding: 0; border: 0; background: none; color: inherit; cursor: pointer; }
  dialog nav button:hover { color: #222; }
</style>
