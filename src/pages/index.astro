---
import Layout from '../Layout.astro';
import Photo from '../Photo.astro';
import photos from '../photos.json';
import Logo from '../logo.svg';
import { EMAIL } from '../contact.js';

const hero = photos.find((p) => p.file === '000010');

// src/collections/<slug>.md, a photo joins one with "collection": "<slug>"; a collection without text shows nothing
const collections = import.meta.glob('../collections/*.md', { eager: true });
const story = (p) => {
  if (!p.collection) return;
  const c = collections[`../collections/${p.collection}.md`];
  if (!c) throw new Error(`${p.file}: no src/collections/${p.collection}.md`);
  return c.rawContent().trim() && c;
};

const mailto = (p) =>
  `mailto:${EMAIL}?subject=${encodeURIComponent(`Enquiry: ${p.title}`)}&body=${encodeURIComponent(
    `Hello Henk,\n\nI'm interested in the photo "${p.title}" (ref. ${p.file}).\n\n`,
  )}`;
const ogImage = new URL(`${import.meta.env.BASE_URL}photos/${hero.file}-1280.jpg`, Astro.site);
---
<Layout image={ogImage} overlay>
  <section class="hero">
    <Photo photo={hero} sizes={`max(100vw, ${Math.round((100 * hero.width) / hero.height)}vh)`} loading="eager" fetchpriority="high" />
    <a class="down" href="#work" aria-label="Scroll to work">
      <svg viewBox="0 0 24 24"><path d="m5 9 7 7 7-7" /></svg>
    </a>
  </section>

  <main id="work">
    {photos.map((p) => (
      <button class="thumb" data-open={`p-${p.file}`}>
        <Photo photo={p} sizes="(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw" />
      </button>
    ))}
  </main>

  {photos.map((p, i) => {
    const c = story(p);
    const prev = photos.at(i - 1);
    const next = photos[(i + 1) % photos.length];
    return (
      <dialog id={`p-${p.file}`}>
        <header>
          <a class="logo" href={import.meta.env.BASE_URL}><Logo /></a>
          <form method="dialog"><nav>
            <button type="button" data-open={`p-${prev.file}`} aria-label="Previous" aria-keyshortcuts="ArrowLeft">
              <svg viewBox="0 0 24 24"><path d="m15 5-7 7 7 7" /></svg>
            </button>
            <button type="button" data-open={`p-${next.file}`} aria-label="Next" aria-keyshortcuts="ArrowRight">
              <svg viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></svg>
            </button>
            <button aria-label="Close" autofocus>
              <svg viewBox="0 0 24 24"><path d="M5 5l14 14M19 5 5 19" /></svg>
            </button>
          </nav></form>
        </header>
        <figure>
          <Photo photo={p} sizes={`min(92vw, ${Math.round((78 * p.width) / p.height)}vh)`} />
          <figcaption>
            <span>{p.title}</span>
            {c && <a class="series" href={`#s-${p.file}`}>{c.frontmatter.title}</a>}
            {p.text && <p class="text" lang="nl">{p.text}</p>}
            <a class="enquire" href={mailto(p)}>Enquire</a>
          </figcaption>
        </figure>
        {c && (
          <section class="text" id={`s-${p.file}`} lang="nl">
            <h2>{c.frontmatter.title}</h2>
            <c.Content />
          </section>
        )}
      </dialog>
    );
  })}

  <script is:inline>
    for (const b of document.querySelectorAll('[data-open]'))
      b.addEventListener('click', () => {
        document.querySelector('dialog[open]')?.close();
        document.getElementById(b.dataset.open).showModal();
      });
    // ← → do what the < > buttons do
    addEventListener('keydown', (e) =>
      e.key.startsWith('Arrow') && document.querySelector(`dialog[open] [aria-keyshortcuts=${e.key}]`)?.click());
    // click on the white space around the photo closes it
    for (const d of document.querySelectorAll('dialog'))
      d.addEventListener('click', (e) => e.target === d && d.close());
  </script>
</Layout>

<style is:global>
  .hero { position: relative; height: 100svh; color: #fff; }
  .hero img { height: 100%; object-fit: cover; }
  .down { position: absolute; bottom: 20px; left: 50%; translate: -50%; filter: drop-shadow(0 0 4px rgb(0 0 0 / 0.6)); }
  .down svg { display: block; width: 32px; height: 32px; stroke-width: 1.5; }

  main { columns: 3 260px; column-gap: 24px; padding: var(--pad); }
  .thumb {
    display: block;
    width: 100%;
    margin: 0 0 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    break-inside: avoid;
  }
  .thumb img { transition: opacity 0.3s; }
  .thumb:hover img { opacity: 0.85; }

  dialog {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #fff;
    box-sizing: border-box;
    padding-bottom: 5vh;
  }
  /* the site header's bar on top; photo centred below it, or scrolling from the top when a story follows */
  dialog[open] { display: flex; flex-direction: column; align-items: center; }
  body:has(dialog[open]) { overflow: hidden; }
  dialog header { position: sticky; top: 0; align-self: stretch; background: #fff; }
  dialog nav button { padding: 0; border: 0; background: none; color: inherit; cursor: pointer; }
  dialog nav button:hover { color: #222; }
  figure { margin: auto 0; }
  figure img { width: auto; max-width: 92vw; max-height: calc(100svh - 240px); }
  figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-top: 20px;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .enquire { padding: 10px 32px; border: 1px solid; font-size: 11px; letter-spacing: 0.2em; text-decoration: none; }
  .enquire:hover { background: #222; color: #fff; }
  .series { margin-top: -8px; font-size: 11px; color: var(--gray); text-decoration: none; }
  .series:hover { color: #222; }

  .text { max-width: 580px; margin: 0; padding: 0 var(--pad); font-size: 15px; letter-spacing: normal; text-transform: none; }
  section.text { margin-top: 64px; }
  .text h2, .text h3 { font-weight: 300; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; }
  .text h2 { margin: 0 0 24px; text-align: center; }
  .text h3 { margin: 32px 0 0; }
</style>
